# frontend/.env.example — copy to frontend/.env.local and fill in real values.
# Everything starting with NEXT_PUBLIC_ ends up in the browser: never put a
# secret here. (Part 22: this file held the wrong content by mistake since Part 14.)

NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
