# backend/.env.example — copy to backend/.env and fill in real values.
# Never commit backend/.env (it is in .gitignore).
# (Part 22: this file held the wrong content by mistake since Part 14.)

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend address(es) allowed to call the API, comma-separated.
# The FIRST one is used in the lockout email's reset link.
FRONTEND_URL=http://localhost:3000

# Optional: 5000 locally; hosts set it themselves.
PORT=5000

# Optional: lockout alert emails (Brevo SMTP relay, Part 22).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=novelle.cst@gmail.com
